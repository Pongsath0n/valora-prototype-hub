# ─── Environment Variables ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Supabase — get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Payment Gateway: "mock" (default, for demo) | "omise" (requires backend)
VITE_PAYMENT_GATEWAY=mock

# Omise test keys (only needed when VITE_PAYMENT_GATEWAY=omise)
# Get your keys at: https://dashboard.omise.co/test/keys
VITE_OMISE_PUBLIC_KEY=pkey_test_your_key_here
