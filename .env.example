# ─── Environment Variables ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Supabase — get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Payment Gateway: "mock" (default, for demo) | "omise" (requires backend)
VITE_PAYMENT_GATEWAY=mock

# Omise test keys (only needed when VITE_PAYMENT_GATEWAY=omise)
# Get your keys at: https://dashboard.omise.co/test/keys
VITE_OMISE_PUBLIC_KEY=pkey_test_your_key_here


# Phase 1 Frontend API / LIFF
VITE_API_BASE_URL=http://localhost:8000
VITE_LIFF_ID=
VITE_DEFAULT_STORE_ID=348544d2-9a2c-4ba4-8875-bc106fed752e

# Security: backend secrets must NEVER be added here.
# Do not put SUPABASE_SERVICE_ROLE_KEY or LINE_CHANNEL_ACCESS_TOKEN in frontend env.
